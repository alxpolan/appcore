generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Team {
  id           String        @id @default(cuid())
  name         String
  members      TeamMember[]
  invites      TeamInvite[]
  apps         App[]
  settings     TeamSettings?
  subscription Subscription?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Subscription {
  id                     String    @id @default(cuid())
  teamId                 String    @unique
  team                   Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  lemonSubscriptionId    String    @unique
  lemonCustomerId        String
  lemonOrderId           String?
  lemonProductId         String?
  lemonVariantId         String?
  status                 String
  interval               String?
  cardBrand              String?
  cardLastFour           String?
  renewsAt               DateTime?
  endsAt                 DateTime?
  trialEndsAt            DateTime?
  updatePaymentMethodUrl String?
  customerPortalUrl      String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([lemonCustomerId])
}

model TeamMember {
  id        String                @id @default(cuid())
  teamId    String
  team      Team                  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      TeamRole              @default(MEMBER)
  appAccess TeamMemberAppAccess[]
  createdAt DateTime              @default(now())

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
}

model TeamMemberAppAccess {
  id           String     @id @default(cuid())
  teamMemberId String
  teamMember   TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  appId        String
  app          App        @relation(fields: [appId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([teamMemberId, appId])
  @@index([teamMemberId])
}

model TeamInvite {
  id         String    @id @default(cuid())
  teamId     String
  team       Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  email      String
  role       TeamRole  @default(MEMBER)
  token      String    @unique
  invitedBy  String
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([teamId])
  @@index([token])
  @@index([email])
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model User {
  id                 String                   @id @default(cuid())
  email              String                   @unique
  name               String?
  passwordHash       String?
  emailVerifiedAt    DateTime?
  tokenVersion       Int                      @default(0)
  role               UserRole                 @default(USER)
  passkeys           PasskeyCredential[]
  teamMembers        TeamMember[]
  emailVerifications EmailVerificationToken[]
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  @@index([email])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasskeyCredential {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String    @unique
  publicKey    Bytes
  counter      BigInt    @default(0)
  deviceType   String    @default("singleDevice")
  backedUp     Boolean   @default(false)
  transports   String[]
  name         String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@index([userId])
}

enum UserRole {
  ADMIN
  USER
}

model TeamSettings {
  id                          String    @id @default(cuid())
  teamId                      String    @unique
  team                        Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  ascIssuerId                 String?
  ascKeyId                    String?
  ascPrivateKey               String?
  ascVendorNumber             String?
  ascAccountConnectRequestedAt DateTime?
  ascAutoKeyId                String?
  ascAutoPrivateKey           String?
  ascAutoConnectedAt          DateTime?
  mcpEnabled                  Boolean   @default(false)
  githubAccessToken           String?
  githubUsername              String?
  githubAvatarUrl             String?
  githubConnectedAt           DateTime?
  presetCopyright             String?
  reviewerFirstName           String?
  reviewerLastName            String?
  reviewerPhone               String?
  reviewerEmail               String?
  reviewerDemoAccountRequired Boolean   @default(false)
  reviewerDemoUsername        String?
  reviewerDemoPassword        String?
  updatedAt                   DateTime  @updatedAt
}

model App {
  id                         String                    @id @default(cuid())
  bundleId                   String                    @unique
  name                       String
  displayName                String?
  teamId                     String?
  team                       Team?                     @relation(fields: [teamId], references: [id], onDelete: SetNull)
  trackId                    BigInt?                   @unique
  country                    String                    @default("de")
  isOwnApp                   Boolean                   @default(false)
  currentTitle               String?
  currentSubtitle            String?
  currentKeywords            String?
  currentDescription         String?
  minimumOsVersion           String?
  analyticsRequestId         String?
  analyticsSnapshotRequestId String?
  githubRepoOwner            String?
  githubRepoName             String?
  githubRepoFullName         String?
  githubWebhookId            BigInt?
  githubWebhookSecret        String?
  githubIosDir               String?
  githubFramework            String?
  signingCertP12             String?
  signingCertPassword        String?
  signingProvisioningProfile String?
  signingTeamId              String?
  snapshotEnvVars            String?
  accentColor                String?
  accentColorIconUrl         String?
  memberAccess               TeamMemberAppAccess[]
  snapshots                  AppSnapshot[]
  rankings                   KeywordRanking[]
  keywordGroups              KeywordGroup[]
  competitors                CompetitorRelation[]      @relation("app_competitors")
  competitorOf               CompetitorRelation[]      @relation("competitor_of")
  screenshotJobs             ScreenshotJob[]
  buildJobs                  BuildJob[]
  asoExperiments             AsoExperiment[]
  competitorReviews          CompetitorReview[]
  reviewSummaries            CompetitorReviewSummary[]
  metadataChanges            AppMetadataChange[]
  inAppPurchases             AppInAppPurchase[]
  keywordSuggestions         KeywordSuggestion[]
  quickScanAi                AppQuickScanAi?
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt

  @@index([bundleId])
  @@index([country])
  @@index([teamId])
}

model AppQuickScanAi {
  id         String   @id @default(cuid())
  appId      String   @unique
  app        App      @relation(fields: [appId], references: [id], onDelete: Cascade)
  inputHash  String
  result     Json
  aiProvider String?
  aiModel    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model AppSnapshot {
  id                String   @id @default(cuid())
  appId             String
  app               App      @relation(fields: [appId], references: [id], onDelete: Cascade)
  title             String
  subtitle          String?
  description       String
  keywords          String?
  rating            Float?
  ratingsCount      Int?
  price             Float?
  version           String?
  releaseNotes      String?
  screenshotUrls    String[]
  iconUrl           String?
  developerName     String?
  category          String?
  categoryId        Int?
  descriptionLength Int?
  wordCount         Int?
  readabilityScore  Float?
  scrapedAt         DateTime @default(now())

  @@index([appId, scrapedAt])
  @@index([scrapedAt])
}

model Keyword {
  id            String                @id @default(cuid())
  term          String
  country       String                @default("de")
  language      String                @default("de")
  popularity    Float?
  difficulty    Float?
  searchVolume  Int?
  rankings      KeywordRanking[]
  searchResults KeywordSearchResult[]
  suggestions   ASOSuggestion[]
  groupMembers  KeywordGroupMember[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@unique([term, country])
  @@index([term])
  @@index([popularity])
}

model KeywordGroup {
  id        String               @id @default(cuid())
  appId     String
  app       App                  @relation(fields: [appId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int                  @default(0)
  members   KeywordGroupMember[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([appId])
}

model KeywordGroupMember {
  id        String       @id @default(cuid())
  groupId   String
  group     KeywordGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  keywordId String
  keyword   Keyword      @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  appId     String

  @@unique([appId, keywordId])
  @@index([groupId])
  @@index([keywordId])
}

model KeywordRanking {
  id        String   @id @default(cuid())
  keywordId String
  keyword   Keyword  @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  appId     String
  app       App      @relation(fields: [appId], references: [id], onDelete: Cascade)
  rank      Int?
  country   String   @default("de")
  trackedAt DateTime @default(now())

  @@index([keywordId, trackedAt])
  @@index([trackedAt])
  @@index([appId, keywordId, trackedAt(sort: Desc)])
  @@index([keywordId, appId, trackedAt(sort: Desc)])
}

model KeywordSearchResult {
  id        String   @id @default(cuid())
  keywordId String
  keyword   Keyword  @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  rank      Int
  trackId   BigInt?
  bundleId  String
  name      String
  iconUrl   String?
  country   String   @default("de")
  trackedAt DateTime @default(now())

  @@index([keywordId, trackedAt])
  @@index([keywordId, bundleId, trackedAt(sort: Desc)])
}

model KeywordSuggestion {
  id           String                  @id @default(cuid())
  appId        String
  app          App                     @relation(fields: [appId], references: [id], onDelete: Cascade)
  term         String
  country      String                  @default("de")
  language     String                  @default("de")
  popularity   Float?
  difficulty   Float?
  searchVolume Int?
  source       String                  @default("ai_discovery")
  status       KeywordSuggestionStatus @default(PENDING)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@unique([appId, term, country])
  @@index([appId, status])
}

enum KeywordSuggestionStatus {
  PENDING
  ADDED
  DISMISSED
}

model CompetitorRelation {
  id             String   @id @default(cuid())
  appId          String
  app            App      @relation("app_competitors", fields: [appId], references: [id], onDelete: Cascade)
  competitorId   String
  competitor     App      @relation("competitor_of", fields: [competitorId], references: [id], onDelete: Cascade)
  relevanceScore Float?
  addedAt        DateTime @default(now())

  @@unique([appId, competitorId])
}

model ASOSuggestion {
  id               String           @id @default(cuid())
  type             SuggestionType
  locale           String           @default("en-US")
  suggestedValue   String
  reasoning        String
  appBundleId      String?
  currentValue     String?
  keywordId        String?
  keyword          Keyword?         @relation(fields: [keywordId], references: [id])
  confidenceScore  Float?
  estimatedImpact  Float?
  status           SuggestionStatus @default(PENDING)
  appliedAt        DateTime?
  resultNotes      String?
  aiProvider       String
  aiModel          String
  promptTokens     Int?
  completionTokens Int?
  createdAt        DateTime         @default(now())

  @@index([appBundleId, status])
  @@index([appBundleId, createdAt])
  @@index([type, status])
  @@index([locale, status])
  @@index([createdAt])
}

enum SuggestionType {
  TITLE
  SUBTITLE
  KEYWORDS
  DESCRIPTION
  SCREENSHOT_ORDER
}

enum SuggestionStatus {
  PENDING
  APPROVED
  APPLIED
  REJECTED
  EXPIRED
}

model AppStoreAnalytics {
  id          String   @id @default(cuid())
  bundleId    String
  reportDate  DateTime
  country     String
  downloads   Int      @default(0)
  updates     Int      @default(0)
  reDownloads Int      @default(0)
  proceeds    Float    @default(0)
  impressions Int      @default(0)
  pageViews   Int      @default(0)
  taps        Int      @default(0)
  sessions    Int      @default(0)
  createdAt   DateTime @default(now())

  @@unique([bundleId, reportDate, country])
  @@index([bundleId, reportDate])
}

model AppStoreAnalyticsPlatform {
  id              String   @id @default(cuid())
  bundleId        String
  reportDate      DateTime
  platformVersion String
  impressions     Int      @default(0)
  pageViews       Int      @default(0)
  taps            Int      @default(0)
  sessions        Int      @default(0)
  createdAt       DateTime @default(now())

  @@unique([bundleId, reportDate, platformVersion])
  @@index([bundleId, reportDate])
}

model AppStoreSessionCohort {
  id            String   @id @default(cuid())
  bundleId      String
  reportDate    DateTime
  downloadDate  String
  sessions      Int      @default(0)
  totalDuration Float    @default(0)
  uniqueDevices Int      @default(0)
  createdAt     DateTime @default(now())

  @@unique([bundleId, reportDate, downloadDate])
  @@index([bundleId, reportDate])
}

model AppStoreInstallDeletion {
  id            String   @id @default(cuid())
  bundleId      String
  reportDate    DateTime
  event         String
  territory     String
  counts        Int      @default(0)
  uniqueDevices Int      @default(0)
  createdAt     DateTime @default(now())

  @@unique([bundleId, reportDate, event, territory])
  @@index([bundleId, reportDate])
}

model AppStoreCommerceDownload {
  id              String   @id @default(cuid())
  bundleId        String
  reportDate      DateTime
  downloadType    String
  appVersion      String
  device          String
  platformVersion String
  sourceType      String
  pageType        String
  preOrder        String
  territory       String
  counts          Int      @default(0)
  createdAt       DateTime @default(now())

  @@unique([bundleId, reportDate, downloadType, appVersion, device, platformVersion, sourceType, pageType, preOrder, territory], name: "downloadDimensions")
  @@index([bundleId, reportDate])
}

model AppStoreCommercePurchase {
  id              String   @id @default(cuid())
  bundleId        String
  reportDate      DateTime
  purchaseType    String
  contentName     String
  contentAppleId  String
  paymentMethod   String
  device          String
  platformVersion String
  sourceType      String
  pageType        String
  appDownloadDate String
  preOrder        String
  territory       String
  purchases       Int      @default(0)
  proceedsUsd     Float    @default(0)
  salesUsd        Float    @default(0)
  payingUsers     Int      @default(0)
  createdAt       DateTime @default(now())

  @@unique([bundleId, reportDate, purchaseType, contentName, contentAppleId, paymentMethod, device, platformVersion, sourceType, pageType, appDownloadDate, preOrder, territory], name: "purchaseDimensions")
  @@index([bundleId, reportDate])
}

model AppReview {
  id               String   @id @default(cuid())
  ascReviewId      String   @unique
  bundleId         String
  rating           Int
  title            String?
  body             String?
  reviewerNickname String?
  territory        String?
  reviewedAt       DateTime
  createdAt        DateTime @default(now())

  @@index([bundleId, reviewedAt])
}

model CompetitorReview {
  id         String   @id @default(cuid())
  appId      String
  app        App      @relation(fields: [appId], references: [id], onDelete: Cascade)
  externalId String?
  rating     Int
  title      String?
  body       String?
  author     String?
  territory  String?
  reviewedAt DateTime
  createdAt  DateTime @default(now())

  @@unique([appId, externalId])
  @@index([appId, reviewedAt])
  @@index([appId, rating])
}

model CompetitorReviewSummary {
  id            String   @id @default(cuid())
  appId         String
  app           App      @relation(fields: [appId], references: [id], onDelete: Cascade)
  reviewCount   Int
  averageRating Float
  summary       String
  strengths     String[]
  weaknesses    String[]
  topThemes     String[]
  sentiment     String?
  aiProvider    String
  aiModel       String
  createdAt     DateTime @default(now())

  @@index([appId, createdAt])
}

model AppMetadataChange {
  id         String   @id @default(cuid())
  appId      String
  app        App      @relation(fields: [appId], references: [id], onDelete: Cascade)
  field      String
  oldValue   String?
  newValue   String?
  detectedAt DateTime @default(now())

  @@index([appId, detectedAt])
  @@index([appId, field])
}

model AppInAppPurchase {
  id        String   @id @default(cuid())
  appId     String
  app       App      @relation(fields: [appId], references: [id], onDelete: Cascade)
  name      String
  price     String?
  kind      String   @default("purchase")
  position  Int      @default(0)
  scrapedAt DateTime @default(now())

  @@index([appId])
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model OAuthClient {
  id           String   @id @default(cuid())
  clientId     String   @unique
  clientSecret String
  name         String
  userId       String?
  redirectUris String[]
  createdAt    DateTime @default(now())

  @@index([userId])
}

model OAuthCode {
  id                  String   @id @default(cuid())
  code                String   @unique
  clientId            String
  userId              String
  redirectUri         String
  codeChallenge       String?
  codeChallengeMethod String?
  expiresAt           DateTime
  used                Boolean  @default(false)
  createdAt           DateTime @default(now())

  @@index([expiresAt])
}

model OAuthToken {
  id          String   @id @default(cuid())
  accessToken String   @unique
  clientId    String
  userId      String
  createdAt   DateTime @default(now())
}

model DeviceToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String?
  bundleId  String?
  platform  String   @default("ios")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([token])
}

model PushNotificationLog {
  id          String   @id @default(cuid())
  deviceToken String
  title       String
  body        String
  category    String?
  data        Json?
  status      String   @default("sent")
  error       String?
  sentAt      DateTime @default(now())

  @@index([category, sentAt])
}

model ScreenshotJob {
  id                     String    @id @default(cuid())
  appId                  String
  app                    App       @relation(fields: [appId], references: [id], onDelete: Cascade)
  commitSha              String
  commitMessage          String?
  branch                 String?
  pusher                 String?
  status                 JobStatus @default(PENDING)
  logs                   String?
  error                  String?
  screenshotUrls         String[]
  framedByLocale         Json?
  screenshotDescriptions Json?
  screenshotSublines     Json?
  startedAt              DateTime?
  completedAt            DateTime?
  createdAt              DateTime  @default(now())

  @@index([appId, createdAt])
  @@index([commitSha])
}

model BuildJob {
  id          String    @id @default(cuid())
  appId       String
  app         App       @relation(fields: [appId], references: [id], onDelete: Cascade)
  branch      String?
  commitSha   String?
  status      JobStatus @default(PENDING)
  logs        String?
  errors      String?
  ipaPath     String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([appId, createdAt])
}

model AsoExperiment {
  id               String              @id @default(cuid())
  appId            String
  app              App                 @relation(fields: [appId], references: [id], onDelete: Cascade)
  type             AsoExperimentType
  fromValue        String?
  toValue          String?
  reason           String?
  confidence       Float
  status           AsoExperimentStatus @default(PENDING)
  rankBefore       Int?
  rankAfter        Int?
  impressionsDelta Int?
  deployedAt       DateTime?
  evaluatedAt      DateTime?
  createdAt        DateTime            @default(now())

  @@index([appId, status])
  @@index([status, deployedAt])
  @@index([createdAt])
}

enum AsoExperimentType {
  KEYWORD_ADD
  KEYWORD_REMOVE
  KEYWORD_REPLACE
  TITLE_CHANGE
  SUBTITLE_CHANGE
}

enum AsoExperimentStatus {
  PENDING
  APPROVED
  DEPLOYED
  EVALUATED
  REJECTED
}

model AppStoreVersion {
  id                          String                        @id // ASC version ID
  bundleId                    String
  ascAppId                    String
  appName                     String
  versionString               String
  appStoreState               String
  platform                    String
  releaseType                 String?
  copyright                   String?
  ageRating                   String?
  reviewerFirstName           String?
  reviewerLastName            String?
  reviewerPhone               String?
  reviewerEmail               String?
  reviewerDemoAccountRequired Boolean?
  reviewerDemoUsername        String?
  reviewerDemoPassword        String?
  reviewDetailId              String?
  syncedAt                    DateTime                      @default(now())
  localizations               AppStoreVersionLocalization[]

  @@index([bundleId, appStoreState])
  @@index([bundleId, syncedAt])
}

model AppStoreVersionLocalization {
  id                     String          @id @default(cuid())
  versionId              String
  version                AppStoreVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  locale                 String
  appInfoLocalizationId  String?
  versionLocalizationId  String?
  name                   String          @default("")
  subtitle               String          @default("")
  description            String          @default("")
  keywords               String          @default("")
  whatsNew               String          @default("")
  promotionalText        String          @default("")
  supportUrl             String          @default("")
  marketingUrl           String          @default("")
  privacyPolicyUrl       String          @default("")
  ascScreenshots         Json?
  ascScreenshotsSyncedAt DateTime?

  @@unique([versionId, locale])
  @@index([versionId])
}

model AscRateLimit {
  id            String   @id @default(cuid())
  teamId        String   @unique
  hourLimit     Int
  hourRemaining Int
  updatedAt     DateTime @updatedAt

  @@index([teamId])
}
